{%- comment -%}
  Renders a single hero-banner-slider slide: media (image or video) + content overlay.
  Accepts: block, section, slide_index, slide_total
{%- endcomment -%}

{%- liquid
  assign heading_color = block.settings.heading_color | default: '#FFFFFF'
  assign description_color = block.settings.description_color | default: '#FFFFFF'
  assign button_bg_color = block.settings.button_bg_color | default: '#FD8DB9'
  assign button_text_color = block.settings.button_text_color | default: '#FFFFFF'
  assign button_hover_bg_color = block.settings.button_hover_bg_color | default: '#E85A91'
  assign button_hover_text_color = block.settings.button_hover_text_color | default: '#FFFFFF'
  assign overlay_color = block.settings.overlay_color | default: '#000000'
  assign overlay_opacity = block.settings.overlay_opacity | default: 0
  assign heading_size_desktop = block.settings.heading_font_size_desktop | default: 48
  assign heading_size_mobile = block.settings.heading_font_size_mobile | default: 28
  assign desc_size_desktop = block.settings.description_font_size_desktop | default: 16
  assign desc_size_mobile = block.settings.description_font_size_mobile | default: 13
  assign button_font_size = block.settings.button_font_size | default: 14
  assign content_padding_left = block.settings.content_padding_left | default: 40
  assign content_padding_right = block.settings.content_padding_right | default: 40
  assign content_max_width = block.settings.content_max_width | default: 480
  assign button_radius = block.settings.button_border_radius | default: 30
-%}

<div class="hero-slide">
  <div class="hero-slide__media">
    {%- if block.settings.media_type == 'video' -%}
      <div class="hero-slide__video-wrapper" data-hero-video>
        {%- if block.settings.desktop_video != blank -%}
          <div class="hero-slide__video hero-slide__video--desktop">
            {{
              block.settings.desktop_video
              | video_tag: muted: true, loop: true, playsinline: true, controls: false, image_size: '1920x'
            }}
          </div>
        {%- endif -%}
        {%- if block.settings.mobile_video != blank -%}
          <div class="hero-slide__video hero-slide__video--mobile">
            {{
              block.settings.mobile_video
              | video_tag: muted: true, loop: true, playsinline: true, controls: false, image_size: '1000x'
            }}
          </div>
        {%- elsif block.settings.desktop_video != blank -%}
          <div class="hero-slide__video hero-slide__video--mobile">
            {{
              block.settings.desktop_video
              | video_tag: muted: true, loop: true, playsinline: true, controls: false, image_size: '1000x'
            }}
          </div>
        {%- endif -%}
        <button type="button" class="hero-slide__play-button" aria-label="Play video">
          {{- 'icon-play.svg' | inline_asset_content -}}
        </button>
      </div>
    {%- else -%}
      <picture class="hero-slide__picture">
        {%- if block.settings.mobile_image != blank -%}
          <source
            media="(max-width: 767px)"
            srcset="{{ block.settings.mobile_image | image_url: width: 400 }} 400w, {{ block.settings.mobile_image | image_url: width: 800 }} 800w, {{ block.settings.mobile_image | image_url: width: 1000 }} 1000w"
          >
        {%- endif -%}
        {%- if block.settings.desktop_image != blank -%}
          {{
            block.settings.desktop_image
            | image_url: width: 3200
            | image_tag: loading: 'lazy', sizes: '100vw', widths: '750, 1100, 1500, 2000, 2600, 3200'
          }}
        {%- else -%}
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </picture>
    {%- endif -%}

    {%- if overlay_opacity > 0 -%}
      <div class="hero-slide__overlay" style="background-color: {{ overlay_color }}; opacity: {{ overlay_opacity | divided_by: 100.0 }};"></div>
    {%- endif -%}

    <div class="hero-slide__scrim hero-slide__scrim--{{ block.settings.content_position }}"></div>
  </div>

  <div
    class="hero-slide__content hero-slide__content--pos-{{ block.settings.content_position }} hero-slide__content--valign-{{ block.settings.vertical_alignment }}"
    style="
      --hbs-heading-color: {{ heading_color }};
      --hbs-desc-color: {{ description_color }};
      --hbs-btn-bg: {{ button_bg_color }};
      --hbs-btn-text: {{ button_text_color }};
      --hbs-btn-hover-bg: {{ button_hover_bg_color }};
      --hbs-btn-hover-text: {{ button_hover_text_color }};
      --hbs-heading-size-desktop: {{ heading_size_desktop }}px;
      --hbs-heading-size-mobile: {{ heading_size_mobile }}px;
      --hbs-desc-size-desktop: {{ desc_size_desktop }}px;
      --hbs-desc-size-mobile: {{ desc_size_mobile }}px;
      --hbs-btn-font-size: {{ button_font_size }}px;
      --hbs-content-padding-left: {{ content_padding_left }}px;
      --hbs-content-padding-right: {{ content_padding_right }}px;
      --hbs-content-max-width: {{ content_max_width }}px;
      --hbs-btn-radius: {{ button_radius }}px;
    "
  >
    {%- if block.settings.heading != blank -%}
      <h2 class="hero-slide__heading">{{ block.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if block.settings.description != blank -%}
      <p class="hero-slide__description">{{ block.settings.description | escape }}</p>
    {%- endif -%}
    {%- if block.settings.button_text != blank -%}
      <a
        href="{{ block.settings.button_link | default: '#' }}"
        class="hero-slide__button"
        {% if block.settings.button_link == blank %}role="link" aria-disabled="true"{% endif %}
      >
        {{- block.settings.button_text | escape -}}
      </a>
    {%- endif -%}
  </div>
</div>
