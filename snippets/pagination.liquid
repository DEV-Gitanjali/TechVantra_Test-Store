{% comment %}
  Renders a set of links for paginated results. Must be used within paginate tags.

  Usage:
  {% paginate results by 2 %}
    {% render 'pagination', paginate: paginate, anchor: '#yourID' %}
  {% endpaginate %}

  Accepts:
  - paginate: {Object}
  - anchor: {String} (optional) This can be added so that on page reload it takes you to wherever you've placed your anchor tag.
{% endcomment %}

{{ 'component-pagination.css' | asset_url | stylesheet_tag }}
{{ 'custom-pagination.css' | asset_url | stylesheet_tag }}

{%- if paginate.parts.size > 0 -%}
  {%- capture chevron_left -%}
    <svg class="pagination__chevron" viewBox="0 0 8 14" fill="none" aria-hidden="true" focusable="false">
      <path d="M6.5 1 1 7l5.5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- endcapture -%}
  {%- capture chevron_right -%}
    <svg class="pagination__chevron" viewBox="0 0 8 14" fill="none" aria-hidden="true" focusable="false">
      <path d="M1.5 1 7 7l-5.5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- endcapture -%}

  <div class="pagination-wrapper" data-page="{{ paginate.current_page }}">
    <nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
      <ul class="pagination__list list-unstyled" role="list">
        {% comment %}
          Both arrows always render so the row keeps its shape — the unavailable one
          is an inert span rather than a link, matching the muted state in the design.
        {% endcomment %}
        <li>
          {%- if paginate.previous -%}
            <a
              href="{{ paginate.previous.url }}{{ anchor }}"
              class="pagination__item pagination__arrow pagination__arrow--prev link motion-reduce"
              aria-label="{{ 'general.pagination.previous' | t }}"
            >
              {{ chevron_left }}
            </a>
          {%- else -%}
            <span
              class="pagination__item pagination__arrow pagination__arrow--prev pagination__arrow--disabled"
              aria-hidden="true"
            >
              {{ chevron_left }}
            </span>
          {%- endif -%}
        </li>

        {%- for part in paginate.parts -%}
          <li>
            {%- if part.is_link -%}
              <a
                href="{{ part.url }}{{ anchor }}"
                class="pagination__item link"
                aria-label="{{ 'general.pagination.page' | t: number: part.title }}"
              >
                {{- part.title -}}
              </a>
            {%- else -%}
              {%- if part.title == paginate.current_page -%}
                <a
                  role="link"
                  aria-disabled="true"
                  class="pagination__item pagination__item--current"
                  aria-current="page"
                  aria-label="{{ 'general.pagination.page' | t: number: part.title }}"
                >
                  {{- part.title -}}
                </a>
              {%- else -%}
                <span class="pagination__item pagination__item--gap">{{ part.title }}</span>
              {%- endif -%}
            {%- endif -%}
          </li>
        {%- endfor -%}

        <li>
          {%- if paginate.next -%}
            <a
              href="{{ paginate.next.url }}{{ anchor }}"
              class="pagination__item pagination__arrow pagination__arrow--next link motion-reduce"
              aria-label="{{ 'general.pagination.next' | t }}"
            >
              {{ chevron_right }}
            </a>
          {%- else -%}
            <span
              class="pagination__item pagination__arrow pagination__arrow--next pagination__arrow--disabled"
              aria-hidden="true"
            >
              {{ chevron_right }}
            </span>
          {%- endif -%}
        </li>
      </ul>
    </nav>
  </div>
{%- endif -%}
