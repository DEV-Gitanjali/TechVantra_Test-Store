{{ 'hero-banner-slider.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

{%- liquid
  assign total = section.blocks.size
  assign total_padded = total
  if total < 10
    assign total_padded = total | prepend: '0'
  endif
  assign height_desktop = section.settings.height_desktop | default: 600
  assign height_tablet = section.settings.height_tablet | default: 500
  assign height_mobile = section.settings.height_mobile | default: 420
  assign padding_top = section.settings.padding_top | default: 0
  assign padding_bottom = section.settings.padding_bottom | default: 0
-%}

<div
  class="hero-banner-slider color-{{ section.settings.color_scheme }}"
  id="HeroBannerSlider-{{ section.id }}"
  style="
    --hbs-height-desktop: {{ height_desktop }}px;
    --hbs-height-tablet: {{ height_tablet }}px;
    --hbs-height-mobile: {{ height_mobile }}px;
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
  "
  data-autoplay="{{ section.settings.enable_autoplay }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed }}"
  data-loop="{{ section.settings.infinite_loop }}"
  data-speed="{{ section.settings.transition_speed }}"
  data-fade="{{ section.settings.fade_effect }}"
  data-pause-on-hover="{{ section.settings.pause_on_hover }}"
  data-touch="{{ section.settings.enable_touch_swipe }}"
>
  <div class="swiper hero-banner-slider__swiper">
    <div class="swiper-wrapper">
      {%- for block in section.blocks -%}
        <div class="swiper-slide" {{ block.shopify_attributes }}>
          {%- render 'hero-slide', block: block, section: section, slide_index: forloop.index, slide_total: total -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.show_pagination -%}
      <div class="swiper-pagination hero-banner-slider__pagination"></div>
    {%- endif -%}
  </div>

  {%- if section.settings.show_arrows or section.settings.show_counter -%}
    <div class="hero-banner-slider__nav">
      {%- if section.settings.show_counter -%}
        <div class="hero-banner-slider__counter" aria-live="polite"><span class="hero-banner-slider__counter-current">01</span><span class="hero-banner-slider__counter-sep" aria-hidden="true">/</span><span class="hero-banner-slider__counter-total">{{ total_padded }}</span></div>
      {%- endif -%}

      {%- if section.settings.show_arrows -%}
        <button
          type="button"
          class="hero-banner-slider__arrow hero-banner-slider__arrow--prev"
          aria-label="Previous slide"
          aria-controls="HeroBannerSlider-{{ section.id }}"
        >
          <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
        </button>
        <button
          type="button"
          class="hero-banner-slider__arrow hero-banner-slider__arrow--next"
          aria-label="Next slide"
          aria-controls="HeroBannerSlider-{{ section.id }}"
        >
          <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
        </button>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer="defer"></script>
<script src="{{ 'hero-banner-slider.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Hero banner slider",
  "tag": "section",
  "class": "section hero-banner-slider-section",
  "max_blocks": 10,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Banner height"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Desktop height",
      "min": 300,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "height_tablet",
      "label": "Tablet height",
      "min": 300,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 500
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Mobile height",
      "min": 250,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 420
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Slider settings"
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "infinite_loop",
      "label": "Infinite loop",
      "default": true
    },
    {
      "type": "range",
      "id": "transition_speed",
      "label": "Transition speed",
      "min": 200,
      "max": 1500,
      "step": 100,
      "unit": "ms",
      "default": 600
    },
    {
      "type": "checkbox",
      "id": "fade_effect",
      "label": "Fade effect",
      "info": "When off, slides transition with a horizontal slide animation instead.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show pagination dots",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_counter",
      "label": "Show slide counter (e.g. 02/03)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause autoplay on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_touch_swipe",
      "label": "Enable touch swipe",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "header",
          "content": "Media"
        },
        {
          "type": "select",
          "id": "media_type",
          "label": "Media type",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Video" }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image",
          "info": "Used on screens narrower than 768px. Falls back to the desktop image if left blank."
        },
        {
          "type": "video",
          "id": "desktop_video",
          "label": "Desktop video"
        },
        {
          "type": "video",
          "id": "mobile_video",
          "label": "Mobile video",
          "info": "Used on screens narrower than 768px. Falls back to the desktop video if left blank."
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Creative Playtime With Building Blocks"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Two young children are deeply engaged in a screen-free, imaginative play session, stacking wooden blocks on a small table."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Show Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "header",
          "content": "Content position"
        },
        {
          "type": "select",
          "id": "content_position",
          "label": "Horizontal position",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        },
        {
          "type": "header",
          "content": "Vertical alignment"
        },
        {
          "type": "select",
          "id": "vertical_alignment",
          "label": "Vertical alignment",
          "options": [
            { "value": "top", "label": "Top" },
            { "value": "middle", "label": "Middle" },
            { "value": "bottom", "label": "Bottom" }
          ],
          "default": "bottom"
        },
        {
          "type": "header",
          "content": "Colors"
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Heading color",
          "default": "#FFFFFF"
        },
        {
          "type": "color",
          "id": "description_color",
          "label": "Description color",
          "default": "#FFFFFF"
        },
        {
          "type": "color",
          "id": "button_bg_color",
          "label": "Button background color",
          "default": "#FD8DB9"
        },
        {
          "type": "color",
          "id": "button_text_color",
          "label": "Button text color",
          "default": "#FFFFFF"
        },
        {
          "type": "color",
          "id": "button_hover_bg_color",
          "label": "Button hover background color",
          "default": "#E85A91"
        },
        {
          "type": "color",
          "id": "button_hover_text_color",
          "label": "Button hover text color",
          "default": "#FFFFFF"
        },
        {
          "type": "color",
          "id": "overlay_color",
          "label": "Overlay color",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Overlay opacity",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 0
        },
        {
          "type": "header",
          "content": "Typography"
        },
        {
          "type": "range",
          "id": "heading_font_size_desktop",
          "label": "Heading font size (desktop)",
          "min": 20,
          "max": 100,
          "step": 2,
          "unit": "px",
          "default": 60
        },
        {
          "type": "range",
          "id": "heading_font_size_mobile",
          "label": "Heading font size (mobile)",
          "min": 16,
          "max": 60,
          "step": 2,
          "unit": "px",
          "default": 28
        },
        {
          "type": "range",
          "id": "description_font_size_desktop",
          "label": "Description font size (desktop)",
          "min": 10,
          "max": 30,
          "step": 1,
          "unit": "px",
          "default": 16
        },
        {
          "type": "range",
          "id": "description_font_size_mobile",
          "label": "Description font size (mobile)",
          "min": 10,
          "max": 24,
          "step": 1,
          "unit": "px",
          "default": 13
        },
        {
          "type": "range",
          "id": "button_font_size",
          "label": "Button font size",
          "min": 10,
          "max": 24,
          "step": 1,
          "unit": "px",
          "default": 14
        },
        {
          "type": "header",
          "content": "Spacing"
        },
        {
          "type": "range",
          "id": "content_padding_left",
          "label": "Content padding left",
          "min": 0,
          "max": 150,
          "step": 5,
          "unit": "px",
          "default": 40
        },
        {
          "type": "range",
          "id": "content_padding_right",
          "label": "Content padding right",
          "min": 0,
          "max": 150,
          "step": 5,
          "unit": "px",
          "default": 40
        },
        {
          "type": "range",
          "id": "content_max_width",
          "label": "Content max width",
          "min": 200,
          "max": 1000,
          "step": 10,
          "unit": "px",
          "default": 480
        },
        {
          "type": "header",
          "content": "Button"
        },
        {
          "type": "range",
          "id": "button_border_radius",
          "label": "Button border radius",
          "min": 0,
          "max": 60,
          "step": 2,
          "unit": "px",
          "default": 30
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero banner slider",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
