{{ 'custom-instagram-feed.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} .instagram-feed {
    background-color: {{ section.settings.background_color }};
  }

  #shopify-section-{{ section.id }} .instagram-feed__heading {
    color: {{ section.settings.heading_color }};
  }

  #shopify-section-{{ section.id }} .instagram-feed__tint {
    background-color: {{ section.settings.overlay_color }};
  }

  #shopify-section-{{ section.id }} .instagram-feed__icon {
    color: {{ section.settings.icon_color }};
  }
{%- endstyle -%}

<div class="instagram-feed">
  <div
    class="instagram-feed__wrapper page-width section-{{ section.id }}-padding"
    style="--instagram-feed-gap: {{ section.settings.item_spacing }}px; --instagram-feed-columns-desktop: {{ section.settings.columns_desktop }}; --instagram-feed-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
  >
    {%- if section.settings.heading != blank -%}
      <h2
        class="instagram-feed__heading {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
      >
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="instagram-feed__grid" role="list">
        {%- for block in section.blocks -%}
          <li
            class="instagram-feed__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            {%- if block.settings.link != blank -%}
              <a
                href="{{ block.settings.link }}"
                class="instagram-feed__link"
                aria-label="{{ 'general.social.links.instagram' | t | default: 'Instagram' }}"
                {% if section.settings.open_in_new_tab %}
                  target="_blank" rel="noopener"
                {% endif %}
              >
            {%- else -%}
              <span class="instagram-feed__link">
            {%- endif -%}
              {%- if block.settings.image != blank -%}
                <img
                  class="instagram-feed__image"
                  srcset="
                    {{ block.settings.image | image_url: width: 300 }} 300w,
                    {{ block.settings.image | image_url: width: 500 }} 500w,
                    {{ block.settings.image | image_url: width: 700 }} 700w
                  "
                  src="{{ block.settings.image | image_url: width: 500 }}"
                  alt="{{ block.settings.image.alt | default: 'Instagram post' | escape }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  loading="lazy"
                >
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'instagram-feed__placeholder placeholder' }}
              {%- endif -%}
              <span class="instagram-feed__overlay" aria-hidden="true">
                <span class="instagram-feed__tint"></span>
                <span class="instagram-feed__icon">
                  {{- 'icon-instagram.svg' | inline_asset_content -}}
                </span>
              </span>
            {%- if block.settings.link != blank -%}
              </a>
            {%- else -%}
              </span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Instagram feed",
  "tag": "section",
  "class": "section custom-instagram-feed-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We're on Instagram"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#159A8D"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Grid"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "item_spacing",
      "label": "Space between images",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open links in a new tab",
      "default": true
    },
    {
      "type": "header",
      "content": "Hover overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#F2F2F2"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 55
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Instagram icon color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "instagram_post",
      "name": "Instagram post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Link to the Instagram post or profile."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram feed",
      "blocks": [
        { "type": "instagram_post" },
        { "type": "instagram_post" },
        { "type": "instagram_post" },
        { "type": "instagram_post" },
        { "type": "instagram_post" }
      ]
    }
  ]
}
{% endschema %}
